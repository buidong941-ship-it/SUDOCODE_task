[
  {
    "template_id": "T08-het-hang-luc-quyet",
    "instances": 3,
    "choose": {
      "cust": "customers()",
      "p": "products(skus=['SKU-MB-STR1','SKU-SN-RUN2','SKU-AP-PRO'])",
      "d1": "days('2026-10-13','2026-10-24')",
      "gap": "range(2,11)"
    },
    "dates": {"call_1": "d1", "call_2": "add(d1,gap)"},
    "let": {
      "address": "cust.address",
      "price1": "final(p.vsku,'call_1')",
      "restock_date": "restock(p.vsku,'call_2')",
      "pname": "p.name + ((' size ' + str(p.size) + ' màu ' + p.color_vi) if p.size else '')"
    },
    "require": ["in_stock(p.vsku,'call_1')", "not in_stock(p.vsku,'call_2')"],
    "scenario": {
      "level": "M1", "persona": "khach_do_du_hoi_nguoi_nha", "hard_case": "het_hang_luc_khach_quyet",
      "notes": "Call_1 còn hàng; call_2 ({{D['call_2']}}) {{p.vsku}} đã HẾT{{(', dự kiến về ' + restock_date) if restock_date else ', chưa có ngày về (NB-02: không được lộ lý do nhà cung cấp)'}}. Agent phải kiểm tra tồn kho theo ngày gọi, không được tạo đơn, không hứa giao.",
      "calls": {
        "call_1": {
          "customer_goal": "hoi {{p.vsku}}, can nhac",
          "customer_turns": [
            "Em ơi {{pname}} giá bao nhiêu, còn hàng không?",
            "Giao về {{address}} mất mấy ngày em?",
            "Để {{cust.xh}} cân nhắc, vài hôm nữa {{cust.xh}} gọi lại chốt nhé."
          ],
          "facts_established": {
            "product_advised": "{{p.sku}}", "variant_sku": "{{p.vsku if p.size else DROP}}", "price_quoted_vnd": "{{price1}}",
            "address": "{{address}}", "blocker": "can nhac"
          },
          "expected_outcome": "hen_goi_lai",
          "ground_truth_facts": {"price_vnd": "{{price1}}", "in_stock": true}
        },
        "call_2": {
          "customer_turns": [
            "Alo em, {{cust.xh}} gọi lại lấy {{pname}} hôm trước đây.",
            "Em lên đơn luôn cho {{cust.xh}} nhé.",
            "Thế bao giờ có hàng lại em? Có thì báo {{cust.xh}} nhé."
          ],
          "must_carry_over": ["product_advised", "price_quoted_vnd"],
          "must_not_ask": ["product_advised", "address"],
          "success_if": {
            "tool_called": null,
            "must_say_any": ["hết hàng", "tạm hết", "hết mất"],
            "must_not_call_tools": ["order.create"],
            "forbidden_claims": [{"field": "in_stock", "value": true}]
          },
          "ground_truth_facts": {"in_stock": false, "restock_date": "{{restock_date if restock_date else DROP}}"},
          "expected_outcome": "hen_goi_lai"
        }
      }
    }
  },
  {
    "template_id": "T09-km-loai-tru-size",
    "instances": 2,
    "choose": {
      "cust": "customers()",
      "p": "products(skus=['SKU-SN-RUN1','SKU-SN-RUN2'], size_in=[43])",
      "d1": "days('2026-10-12','2026-10-25')"
    },
    "dates": {"call_1": "d1"},
    "let": {
      "address": "cust.address",
      "ref": "variant_of(product(p.sku), 42, p.color)",
      "price": "final(p.vsku,'call_1')",
      "wrong": "int(p.price_list * 0.9)",
      "wrong2": "int(p.list * 0.9)"
    },
    "require": ["ref is not None", "best_promo(ref.vsku,'call_1') == 'RUN-10'", "in_stock(p.vsku,'call_1')", "'RUN-10' not in promos(p.vsku,'call_1')"],
    "scenario": {
      "level": "M1", "persona": "khach_so_gia", "hard_case": "km_loai_tru_size",
      "notes": "RUN-10 loại trừ size 43 (đã có phụ thu size lớn, KM-02). Giá đúng size 43 = {{vnd(price)}} (niêm yết {{vnd(p.list)}} + phụ thu {{vnd(p.price_list - p.list)}}). Agent không được áp 10% cho size 43.",
      "calls": {
        "call_1": {
          "customer_goal": "mua {{p.vsku}}, tuong duoc giam 10%",
          "customer_turns": [
            "Shop ơi {{p.name}} đang giảm 10% phải không em?",
            "{{cust.Xh}} đi size 43 màu {{p.color_vi}}, vậy giảm xong còn {{k(wrong2)}} đúng không?",
            "Sao size 43 lại không được giảm?",
            "Thôi được, lên đơn size 43 cho {{cust.xh}}, giao về {{address}}."
          ],
          "facts_established": {"product_advised": "{{p.sku}}", "variant_sku": "{{p.vsku}}", "size": 43, "color": "{{p.color}}", "price_quoted_vnd": "{{price}}"},
          "success_if": {
            "tool_called": "order.create", "args_match": {"sku": "{{p.vsku}}", "price_vnd": "{{price}}"},
            "forbidden_claims": [{"field": "price_vnd", "value": "{{wrong}}"}, {"field": "price_vnd", "value": "{{wrong2}}"}]
          },
          "ground_truth_facts": {"price_vnd": "{{price}}", "list_price_vnd": "{{p.price_list}}", "promo_RUN-10_active": false, "in_stock": true},
          "expected_outcome": "chot_don"
        }
      }
    }
  },
  {
    "template_id": "T10-quay-lai-8-thang",
    "instances": 2,
    "choose": {
      "cust": "customers(ids=['C031'], reuse=True)",
      "p": "products(skus=['SKU-AP-X','SKU-AP-Y','SKU-AP-PRO'])",
      "d1": "days('2026-10-13','2026-10-24')",
      "new_address": "['88 Láng Hạ, Đống Đa, Hà Nội', '15 Xuân Thủy, Cầu Giấy, Hà Nội']"
    },
    "dates": {"call_1": "d1"},
    "let": {
      "address": "new_address",
      "old_address": "'12 ngõ 38 Hoàng Cầu, Đống Đa, Hà Nội'",
      "price": "final(p.vsku,'call_1', address=new_address)"
    },
    "require": ["in_stock(p.vsku,'call_1')", "best_promo(p.vsku,'call_1') == 'TRADE-IN-AP'"],
    "scenario": {
      "level": "M1", "persona": "khach_quay_lai_sau_8_thang", "hard_case": "quay_lai_sau_8_thang",
      "notes": "Khách C031 mua SKU-AP-X-2024 ngày 2026-02-17 (đã NGỪNG BÁN, successor SKU-AP-X). Địa chỉ cũ quá TTL → phải xác nhận lại, không tự dùng. TRADE-IN-AP (−400k) có lợi hơn AIR-OCT/GIFT-FILTER → giá {{vnd(price)}}.",
      "calls": {
        "call_1": {
          "customer_goal": "doi may cu AP-X-2024 lay {{p.sku}}",
          "seed_history": "{{cust.sessions}}",
          "customer_turns": [
            "Alo em, chị mua máy lọc AirPure X bên em hồi tháng 2, giờ chị muốn đổi lên máy mới.",
            "Mẫu y như cũ còn không em? Không thì chị lấy {{p.short}}.",
            "Bên em có chương trình thu cũ đổi mới không?",
            "Ok lên đơn cho chị, giao về địa chỉ cũ nhé.",
            "À chị chuyển nhà rồi, giờ ở {{new_address}}."
          ],
          "must_not_ask": ["owned_product"],
          "success_if": {
            "tool_called": "order.create", "args_match": {"sku": "{{p.vsku}}", "price_vnd": "{{price}}"},
            "must_say_any": ["ngừng kinh doanh", "ngừng bán", "không còn kinh doanh", "không còn bán", "đã ngừng"]
          },
          "memory_expectation": {"address": "{{new_address}}", "superseded": "{{old_address}}", "address_ttl_check": true},
          "ground_truth_facts": {
            "price_vnd": "{{price}}", "list_price_vnd": "{{p.list}}", "promo_TRADE-IN-AP_active": true, "in_stock": true,
            "discontinued_sku": "SKU-AP-X-2024", "successor_sku": "SKU-AP-X"
          },
          "expected_outcome": "chot_don"
        }
      }
    }
  },
