          "facts_established": {"speaker_customer_id": "C035", "product_advised": "{{p.sku}}", "price_quoted_vnd": "{{price}}", "address": "{{address}}", "payment": "COD"},
          "success_if": {
            "tool_called": "order.create", "args_match": {"sku": "{{p.vsku}}", "price_vnd": "{{price}}"},
            "forbidden_claims": ["cô Loan", "máy lọc nước"]
          },
          "memory_expectation": {"product_advised": "{{p.sku}}", "must_not_write_to": "C034"},
          "ground_truth_facts": {"price_vnd": "{{price}}", "in_stock": true},
          "expected_outcome": "chot_don"
        },
        "call_2": {
          "customer_turns": [
            "Alo, cô là Loan đây, hôm trước cô hỏi cái máy lọc nước cho nhà ở Cần Thơ.",
            "Con gái cô đồng ý rồi, giá bao nhiêu cháu?",
            "Ừ lên đơn cho cô, giao về {{loan_addr}}."
          ],
          "seed_history": [{"customer_id": "C034", "session_id": "S-OLD-3", "date": "2026-10-09", "channel": "hotline", "summary": "Cô Loan hỏi máy lọc nước RO Karofi 9 lõi, nhà ở Cần Thơ, chờ con gái quyết", "outcome": "hen_goi_lai"}],
          "must_carry_over": ["product_advised"],
          "must_not_ask": ["product_advised"],
          "success_if": {
            "tool_called": "order.create", "args_match": {"sku": "SKU-WF-RO9", "price_vnd": "{{ro_price}}"},
            "forbidden_claims": ["chị Dung", "{{p.short}}"]
          },
          "memory_expectation": {"product_advised": "SKU-WF-RO9", "must_not_write_to": "C035"},
          "ground_truth_facts": {"price_vnd": "{{ro_price}}", "in_stock": true, "freeship": true, "promo_NAM-SHIP0_active": true},
          "expected_outcome": "chot_don"
        }
      }
    }
