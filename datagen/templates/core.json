    "require": [
      "newp is not None", "in_stock(p.vsku,'call_1')", "in_stock(newp.vsku,'call_2')",
      "final(newp.vsku,'call_2') == price",
      "not any(promo(c).get('conditions', {}).get('once_per_customer') for c in promos(p.vsku,'call_1'))"
    ],
    "reproduce": {"id": "SAMPLE-03", "fix": {"cust": "customers(ids=['C012'],reuse=True)", "p": "products(skus=['SKU-SN-CAS'], size_in=[39], color_in=['den'])", "d1": "['2026-10-15']", "gap": "[4]", "oid": "'OD682761'"}},
    "scenario": {
      "level": "M1", "persona": "khach_da_mua_doi_size", "hard_case": null,
      "notes": "Cuộc 2 (Case 3): hệ thống phải biết đơn nào, size/màu nào; áp chính sách đổi trả 7 ngày miễn phí đổi size lần đầu (DT-03).",
      "calls": {
        "call_1": {
          "customer_goal": "mua {{p.sku}} size {{p.size}} mau {{p.color}}",
          "customer_turns": [
            "Em ơi {{p.name}} còn size {{p.size}} màu {{p.color_vi}} không?",
            "Giá bao nhiêu, có giảm gì không em?",
            "Ok em lên đơn cho {{cust.xh}}, thanh toán COD nhé."
          ],
          "facts_established": {
            "product_advised": "{{p.sku}}", "variant_sku": "{{p.vsku}}", "size": "{{p.size}}", "color": "{{p.color}}",
            "price_quoted_vnd": "{{price}}", "order_id": "{{oid}}", "payment": "COD"
          },
          "expected_outcome": "chot_don"
        },
        "call_2": {
          "customer_turns": [
            "Alo, {{cust.xh}} mới nhận {{item}} hôm qua mà size {{p.size}} {{'hơi chật' if item == 'giày' else 'hơi bé'}}.",
            "Đổi lên size {{newp.size}} được không em? Mất phí gì không?",
            "Ừ em làm thủ tục đổi cho {{cust.xh}} nhé."
          ],
          "must_carry_over": ["order_id", "variant_sku", "size", "color"],
          "must_not_ask": ["product_advised", "order_id", "color", "payment"],
          "success_if": {"tool_called": "order.update", "args_match": {"order_id": "{{oid}}", "new_variant_sku": "{{newp.vsku}}", "action": "exchange_size"}},
          "ground_truth_facts": {"return_days": 7, "exchange_fee_vnd": 0, "new_size_in_stock": true, "price_vnd": "{{price}}"}
        }
      }
    }
  },
