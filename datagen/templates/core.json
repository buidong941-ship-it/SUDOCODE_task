  {
    "template_id": "T06-asr-het-hang-ve-hang",
    "instances": 3,
    "choose": {
      "cust": "customers(need=['zalo_id'])",
      "p": "products(skus=['SKU-XM-4P','SKU-AP-PRO'])",
      "d1": "days('2026-10-13','2026-10-22')",
      "gap": "range(1,7)"
    },
    "dates": {"call_1": "d1", "call_2": "add(d1,gap)"},
    "let": {
      "address": "cust.address",
      "restock_date": "restock(p.vsku,'call_1')",
      "price1": "final(p.vsku,'call_1')",
      "price2": "final(p.vsku,'call_2')",
      "area": "pick([a for a in (20,25,30,35,40,45) if a <= p.attrs['room_area_m2']])",
      "budget": "((price1 + 499999) // 500000) * 500000",
      "wife": "'vợ' if cust.honorific == 'anh' else 'chồng'",
      "c1": "['Alo cho ' + cust.xh + ' hỏi máy lọc không khí ' + p.short + ' giá bao nhiêu?', 'Phòng ' + cust.xh + ' ' + str(area) + 'm² có được không?', 'Ngân sách ' + cust.xh + ' tầm ' + trieu(budget) + ' thôi, để ' + cust.xh + ' hỏi ' + wife + ' đã.']",
      "c1_asr": "['a lô cho ' + cust.xh + ' hỏi máy lọc không khí ' + spoken(p.short) + ' giá bao nhiêu', 'phòng ' + cust.xh + ' ' + num_words(area) + ' mét vuông có được không', 'ngân sách ' + cust.xh + ' tầm ' + trieu_words(budget) + ' thôi để ' + cust.xh + ' hỏi ' + wife + ' đã']",
      "c2": "['Em ơi hôm trước ' + cust.xh + ' hỏi cái ' + p.short + '.', wife[0].upper() + wife[1:] + ' ' + cust.xh + ' ok rồi, sản phẩm này có ship COD không, ' + cust.xh + ' ở ' + address + '.', 'Ok lên đơn cho ' + cust.xh + ' nhé.']"
    },
    "require": [
      "area is not None", "not in_stock(p.vsku,'call_1')", "restock_date is not None", "in_stock(p.vsku,'call_2')",
      "price2 < 10000000"
    ],
    "reproduce": {"id": "SAMPLE-06", "fix": {"cust": "customers(ids=['C030'],reuse=True)", "p": "products(skus=['SKU-XM-4P'])", "d1": "['2026-10-15']", "gap": "[5]", "area": "35"}},
    "scenario": {
      "level": "M1", "persona": "khach_do_du_hoi_nguoi_nha", "hard_case": "asr_loi_va_teencode",
      "notes": "Script chấm đưa customer_turns_asr vào hệ thống. Call_1: {{p.sku}} đang HẾT hàng, dự kiến về {{restock_date}} → agent không được hứa giao ngay. Call_2 ({{D['call_2']}}): đã có hàng; KM áp dụng: {{', '.join(promos(p.vsku,'call_2'))}}.",
      "calls": {
        "call_1": {
          "customer_goal": "hoi may loc khong khi, transcript ASR loi",
          "input_mode": "asr_transcript",
          "customer_turns_asr": "{{c1_asr}}",
          "customer_turns": "{{c1}}",
          "facts_established": {
            "product_advised": "{{p.sku}}", "room_area_m2": "{{area}}", "budget_vnd": "{{budget}}",
            "price_quoted_vnd": "{{price1}}", "blocker": "{{'can hoi vo' if wife == 'vợ' else 'can hoi chong'}}"
          },
          "expected_outcome": "hen_goi_lai",
          "ground_truth_facts": {"price_vnd": "{{price1}}", "in_stock": false, "restock_date": "{{restock_date}}"}
        },
        "call_2": {
          "channel": "zalo_oa",
          "input_mode": "chat_teencode",
          "customer_turns_asr": "{{[teen(t) for t in c2]}}",
          "customer_turns": "{{c2}}",
          "must_carry_over": ["product_advised", "price_quoted_vnd", "room_area_m2"],
          "must_not_ask": ["room_area_m2", "budget_vnd", "product_advised"],
          "success_if": {"tool_called": "order.create", "args_match": {"sku": "{{p.vsku}}", "price_vnd": "{{price2}}", "payment": "COD"}},
          "ground_truth_facts": {
            "price_vnd": "{{price2}}", "in_stock": true, "restock_date": "{{restock_date}}", "freeship": "{{q(p.vsku,'call_2')['freeship']}}",
            "{{'promo_NAM-SHIP0_active' if 'NAM-SHIP0' in promos(p.vsku,'call_2') else DROP}}": true
          }
        }
      }
    }
  },
  {
    "template_id": "T07-chinh-sach-cu",
    "instances": 2,
    "choose": {"cust": "customers()", "d1": "days('2026-10-02','2026-10-30')", "v": "[0, 1]"},
