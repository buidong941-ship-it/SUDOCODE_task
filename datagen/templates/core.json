[
  {
    "template_id": "T01-do-du-hoi-nguoi-nha",
    "instances": 3,
    "choose": {
      "cust": "customers()",
      "p": "products(category='gia-dung/may-loc-khong-khi')",
      "d1": "days('2026-10-13','2026-10-20')",
      "gap": "range(1,5)"
    },
    "dates": {"call_1": "d1", "call_2": "add(d1,gap)"},
    "let": {
      "address": "cust.address",
      "price": "final(p.vsku,'call_1')",
      "promo_code": "best_promo(p.vsku,'call_1')",
      "area": "pick([a for a in (15,20,25,30,35,40) if a <= p.attrs['room_area_m2']])",
      "has_children": "bool(p.attrs.get('child_safe_lock', False))",
      "budget": "price + 500000",
      "spouse": "'ông xã' if cust.honorific in ('chị','cô') else 'bà xã'",
      "blocker": "'can hoi chong' if cust.honorific in ('chị','cô') else 'can hoi vo'"
    },
    "require": [
      "area is not None",
      "in_stock(p.vsku,'call_1')", "in_stock(p.vsku,'call_2')",
      "promo_code is not None", "promo_active(promo_code,'call_2')",
      "final(p.vsku,'call_2') == price"
    ],
    "reproduce": {"id": "SAMPLE-01", "fix": {"cust": "customers(ids=['C001'],reuse=True)", "p": "products(skus=['SKU-AP-Y'])", "d1": "['2026-10-15']", "gap": "[2]", "area": "25", "budget": "5700000"}},
    "scenario": {
      "level": "M1", "persona": "khach_do_du_hoi_nguoi_nha", "hard_case": null,
      "notes": "Kịch bản lõi Case 1. Cuộc 2 phải mở đầu bằng xác nhận tiếp nối, không hỏi lại diện tích/ngân sách/có trẻ nhỏ.",
      "calls": {
        "call_1": {
          "customer_goal": "hoi {{p.name}} cho phong {{area}}m2, ngan sach {{trieu(budget)}}",
          "customer_turns": [
            "Alo, {{cust.xh}} muốn hỏi máy lọc không khí cho phòng ngủ khoảng {{area}} mét vuông, {{cust.xh}} đang xem mẫu {{p.short}}.",
            "{{('Nhà ' + cust.xh + ' có bé nhỏ, ngân sách') if has_children else ('Ngân sách ' + cust.xh)}} tầm {{trieu(budget)}} thôi em.",
            "Máy này có khuyến mãi gì không em?",
            "Ừ để {{cust.xh}} hỏi {{spouse}} rồi gọi lại em nhé."
          ],
          "facts_established": {
            "room_area_m2": "{{area}}", "has_children": "{{has_children}}", "budget_vnd": "{{budget}}",
            "product_advised": "{{p.sku}}", "price_quoted_vnd": "{{price}}", "promo_code": "{{promo_code}}",
            "promo_expiry": "{{promo_end(promo_code)}}", "blocker": "{{blocker}}"
          },
          "expected_outcome": "hen_goi_lai"
        },
        "call_2": {
          "customer_turns": [
            "Alo, hôm trước {{cust.xh}} có gọi hỏi máy lọc không khí đó em.",
            "{{spouse[0].upper() + spouse[1:]}} {{cust.xh}} đồng ý rồi, giá vẫn như hôm trước đúng không?",
            "Ừ em lên đơn cho {{cust.xh}} đi, giao về {{address}} nhé."
          ],
          "must_carry_over": ["product_advised", "price_quoted_vnd", "room_area_m2", "blocker"],
          "must_not_ask": ["room_area_m2", "budget_vnd", "has_children", "product_advised"],
          "success_if": {"tool_called": "order.create", "args_match": {"sku": "{{p.vsku}}", "price_vnd": "{{final(p.vsku,'call_2')}}"}},
          "ground_truth_facts": {"price_vnd": "{{final(p.vsku,'call_2')}}", "promo_active": true, "in_stock": true, "delivery_days": "{{region_days(address)}}"}
        }
      }
    }
  },
  {
    "template_id": "T02-so-gia",
    "instances": 3,
    "choose": {
      "cust": "customers()",
      "p": "products(category='gia-dung', variants=False, min_price=1500000)",
      "d1": "days('2026-10-13','2026-10-20')",
      "gap": "range(2,6)",
      "cdrop": "[200000, 300000, 400000]"
    },
    "dates": {"call_1": "d1", "call_2": "add(d1,gap)"},
    "let": {
      "address": "cust.address",
      "price": "final(p.vsku,'call_1')",
      "competitor": "price - cdrop",
      "alts": "[a for a in products(category=p.category, variants=False) if a.sku != p.sku and a.list < p.list and in_stock(a.vsku,'call_1')]",
      "alt": "sorted(alts, key=lambda a: a.list)[-1] if alts else None",
      "promo_active2": "any(promo(c)['type'] in ('fixed','percent','percent_second_item','gift') for c in promos(p.vsku,'call_2'))"
    },
    "require": ["in_stock(p.vsku,'call_1')", "in_stock(p.vsku,'call_2')", "final(p.vsku,'call_2') == price"],
    "reproduce": {"id": "SAMPLE-02", "fix": {"cust": "customers(ids=['C007'],reuse=True)", "p": "products(skus=['SKU-AP-X'])", "d1": "['2026-10-15']", "gap": "[3]", "cdrop": "[300000]"}},
    "scenario": {
      "level": "M1", "persona": "khach_so_gia", "hard_case": null,
      "notes": "Agent KHÔNG được tự bịa giảm giá để chốt, không xác nhận/phủ nhận giá đối thủ (PB-02). Giá ở cuộc 2 phải bằng giá đã báo.",
      "calls": {
        "call_1": {
          "customer_goal": "so gia {{p.sku}} voi ben khac",
          "customer_turns": [
            "Em ơi {{p.name}} bên em giá bao nhiêu?",
            "Bên kia {{cust.xh}} thấy đang bán {{k(competitor)}} thôi, sao bên em đắt hơn?",
            "Thế bảo hành thế nào? {{cust.Xh}} cân nhắc thêm rồi báo lại."
          ],
          "facts_established": {
            "product_advised": "{{p.sku}}", "price_quoted_vnd": "{{price}}", "competitor_price_vnd": "{{competitor}}",
            "objection": "dat_qua", "alt_suggested": "{{alt.sku if alt else DROP}}", "blocker": "so sanh gia"
          },
          "expected_outcome": "hen_goi_lai"
        },
        "call_2": {
          "customer_turns": [
            "{{cust.Xh}} gọi lại vụ {{p.name}} hôm trước.",
            "Nếu bên em không giảm thêm được thì có tặng gì kèm không?",
            "Thôi được, {{cust.xh}} lấy cái đó, giao về {{address}} trong tuần này nhé."
          ],
          "must_carry_over": ["product_advised", "price_quoted_vnd", "competitor_price_vnd", "objection"],
          "must_not_ask": ["product_advised", "competitor_price_vnd"],
          "success_if": {"tool_called": "order.create", "args_match": {"sku": "{{p.vsku}}", "price_vnd": "{{price}}"}},
          "ground_truth_facts": {
            "price_vnd": "{{price}}", "warranty_months": "{{p.attrs.get('warranty_months', DROP)}}",
            "promo_active": "{{promo_active2}}", "in_stock": true, "delivery_days": "{{region_days(address)}}"
          }
        }
      }
    }
  },
  {
