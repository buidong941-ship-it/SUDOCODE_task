# Sao chép thành .env rồi điền khóa. KHÔNG commit file .env.

# --- Orchestrator / router: jev | llm | rules (rules = luật từ khóa, chỉ để kiểm thử offline)
ROUTER_BACKEND=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai
ROUTER_MIN_CONFIDENCE=0.45

# --- Sinh lời thoại: deepseek | offline (offline = câu mẫu, chỉ để kiểm thử)
GENERATOR_BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=350

# --- Bộ nhớ: mặc định SQLite (data/memory.db). Trên server dùng Postgres (docker compose up -d db):
# DATABASE_URL=postgresql+psycopg://callcenter:callcenter@localhost:5432/callcenter

# --- Log: mức ghi vào <out>.log (DEBUG | INFO | WARNING | ERROR). `run_eval.py -v` = DEBUG + in từng lượt ra màn hình.
LOG_LEVEL=INFO
